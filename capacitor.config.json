{
  "appId": "uz.sicrm.app",
  "appName": "SICRM",
  "webDir": "mobile/www",
  "server": {
    "errorPath": "offline.html",
    "allowNavigation": [
      "*.sicrm.uz",
      "sicrm.uz"
    ]
  },
  "android": {
    "backgroundColor": "#0B0B0F"
  },
  "ios": {
    "backgroundColor": "#0B0B0F",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0B0B0F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0B0F",
      "overlaysWebView": false
    }
  },
  "appendUserAgent": "SICRM-App"
}
